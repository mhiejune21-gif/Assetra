@model Assetra.Models.LendingRecord
@{
    ViewData["Title"] = "Process Tool Return";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isOverdue = Model.DueDate < DateTime.Today;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold text-dark">Process Tool Return</h4>
        <p class="text-muted small mb-0">Verify and log the return of a borrowed tool/equipment.</p>
    </div>
    <a href="/Lending" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to History</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-indigo text-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-arrow-left-right me-2 text-warning"></i>Active Loan Details</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 mb-4 border-bottom pb-4">
                    <!-- Tool Details -->
                    <div class="col-md-6 border-end-md">
                        <span class="text-muted small fw-bold text-uppercase d-block mb-2">Tool Information</span>
                        <h5 class="fw-bold text-indigo-900 mb-1">@Model.Property?.Name</h5>
                        <div class="font-monospace text-muted small mb-2">ID: @Model.PropertyId</div>
                        <div class="small">
                            <span class="text-muted">Outward Condition:</span>
                            <span class="badge bg-secondary">@Model.BorrowedCondition</span>
                        </div>
                    </div>

                    <!-- Borrower Details -->
                    <div class="col-md-6">
                        <span class="text-muted small fw-bold text-uppercase d-block mb-2">Borrower Information</span>
                        <h5 class="fw-bold text-slate-800 mb-1">@Model.BorrowerName</h5>
                        <div class="font-monospace text-muted small mb-2">Student ID: @Model.StudentId</div>
                        <div class="small text-muted">
                            Borrowed: <strong>@Model.DateBorrowed.ToString("yyyy-MM-dd HH:mm")</strong>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <span class="text-muted small d-block">Scheduled Due Date:</span>
                        <strong class="@(isOverdue ? "text-danger fw-bold" : "text-dark")">@Model.DueDate.ToString("yyyy-MM-dd")</strong>
                        @if (isOverdue)
                        {
                            <span class="badge bg-danger ms-2">Overdue</span>
                        }
                    </div>
                </div>

                <form id="returnForm" method="post" action="/Lending/ReturnTool">
                    <input type="hidden" name="id" value="@Model.LendingId" />

                    <!-- Condition Selection -->
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold small text-uppercase">1. Record Return Condition</label>
                        <select name="returnedCondition" id="returnedConditionSelect" class="form-select border-2" required>
                            <option value="Good" selected="@(Model.BorrowedCondition == "Good")">Good (Fully Functional)</option>
                            <option value="Minor Damage" selected="@(Model.BorrowedCondition == "Minor Damage")">Minor Damage (Needs minor check)</option>
                            <option value="Damaged" selected="@(Model.BorrowedCondition == "Damaged")">Damaged (Requires repair)</option>
                            <option value="Missing Parts" selected="@(Model.BorrowedCondition == "Missing Parts")">Missing Parts (Partially complete)</option>
                        </select>
                    </div>

                    <!-- Return Notes -->
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold small text-uppercase">2. Return Notes / Observation</label>
                        <textarea name="notes" id="notesInput" class="form-control" rows="3" placeholder="Describe the physical condition of the returned tool, missing accessories, or general remarks..."></textarea>
                    </div>

                    <div class="border-top pt-4">
                        <button type="button" id="btnSubmitCheck" class="btn btn-success w-100 py-2 shadow-sm fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Verify Return
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Return Confirmation Modal -->
<div class="modal fade" id="confirmReturnModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold" id="confirmModalLabel"><i class="bi bi-question-circle me-2"></i>Confirm Tool Return</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-4">Please review and confirm the return details before finalizing:</p>
                
                <div class="mb-3 border-bottom pb-2">
                    <span class="text-muted small d-block">Returned Tool:</span>
                    <strong class="text-indigo-900">@Model.Property?.Name</strong>
                    <span class="text-muted small font-monospace d-block">ID: @Model.PropertyId</span>
                </div>

                <div class="mb-3 border-bottom pb-2">
                    <span class="text-muted small d-block">Borrower:</span>
                    <strong class="text-slate-800">@Model.BorrowerName</strong>
                    <span class="text-muted small font-monospace d-block">Student ID: @Model.StudentId</span>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <span class="text-muted small d-block">Outgoing Condition:</span>
                        <span class="badge bg-secondary">@Model.BorrowedCondition</span>
                    </div>
                    <div class="col-6">
                        <span class="text-muted small d-block">Return Condition:</span>
                        <span id="summaryReturnCondition" class="badge"></span>
                    </div>
                </div>

                <div class="mb-3 d-none" id="summaryNotesContainer">
                    <span class="text-muted small d-block">Observation Notes:</span>
                    <p id="summaryNotes" class="bg-light p-2 rounded small text-dark mb-0 font-italic"></p>
                </div>

                <div class="alert alert-success py-2 small border-0 mt-4 mb-0" style="background-color: #f0fdf4; color: #15803d;">
                    <i class="bi bi-check2-circle me-2"></i>
                    <span>This tool will be marked <strong>Available</strong> and returned to active inventory.</span>
                </div>
            </div>
            <div class="modal-footer bg-light p-3">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmSubmit" class="btn btn-success px-4">Confirm Return</button>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-indigo {
        background-color: #4f46e5;
    }
    .text-indigo-900 {
        color: #312e81;
    }
    @@media (min-width: 768px) {
        .border-end-md {
            border-right: 1px solid #e2e8f0 !important;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const confirmModal = new bootstrap.Modal(document.getElementById('confirmReturnModal'));
            
            const btnSubmitCheck = document.getElementById("btnSubmitCheck");
            const btnConfirmSubmit = document.getElementById("btnConfirmSubmit");
            const returnForm = document.getElementById("returnForm");
            
            const returnedConditionSelect = document.getElementById("returnedConditionSelect");
            const notesInput = document.getElementById("notesInput");

            btnSubmitCheck.addEventListener("click", function () {
                if (!returnForm.checkValidity()) {
                    returnForm.reportValidity();
                    return;
                }

                const returnCondition = returnedConditionSelect.options[returnedConditionSelect.selectedIndex].value;
                const notes = notesInput.value.trim();

                // Update summary modal
                const summaryBadge = document.getElementById("summaryReturnCondition");
                summaryBadge.innerText = returnCondition;
                summaryBadge.className = "badge";

                if (returnCondition === "Good") summaryBadge.classList.add("bg-success");
                else if (returnCondition === "Minor Damage") summaryBadge.classList.add("bg-info", "text-dark");
                else if (returnCondition === "Damaged") summaryBadge.classList.add("bg-warning", "text-dark");
                else summaryBadge.classList.add("bg-danger");

                const notesContainer = document.getElementById("summaryNotesContainer");
                if (notes) {
                    notesContainer.classList.remove("d-none");
                    document.getElementById("summaryNotes").innerText = notes;
                } else {
                    notesContainer.classList.add("d-none");
                }

                // Show modal
                confirmModal.show();
            });

            btnConfirmSubmit.addEventListener("click", function () {
                confirmModal.hide();
                returnForm.submit();
            });
        });
    </script>
}
