@model List<Assetra.Models.MaintenanceRecord>
@{
    ViewData["Title"] = "Maintenance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Maintenance Records</h4>
    <a href="/Maintenance/Create" class="btn btn-primary">+ Schedule Maintenance</a>
</div>

<table class="table table-bordered bg-white">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Property ID</th>
            <th>Description</th>
            <th>Scheduled Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaintenanceId</td>
                <td>@item.PropertyId</td>
                <td>@item.Description</td>
                <td>@item.ScheduledDate.ToString("MMM dd, yyyy")</td>
                <td>
                    <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "In Progress" ? "bg-warning" : "bg-info")">
                        @item.Status
                    </span>
                </td>
                <td>
                    @if (item.Status == "Scheduled")
                    {
                        <a href="/Maintenance/MarkInProgress/@item.MaintenanceId" class="btn btn-sm btn-warning">Start</a>
                    }
                    @if (item.Status == "In Progress")
                    {
                        <a href="/Maintenance/MarkComplete/@item.MaintenanceId" class="btn btn-sm btn-success">Complete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>