@model List<Assetra.Models.LendingRecord>
@{
    ViewData["Title"] = "Pending Approvals";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold text-dark">Pending Lending Approvals</h4>
        <p class="text-muted small mb-0">Approve or reject student-initiated borrowing requests.</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4 text-danger small py-2 px-3" style="background-color: #fef2f2;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">TX ID</th>
                        <th>Tool Name</th>
                        <th>Student Borrower</th>
                        <th>Proposed Date</th>
                        <th>Expected Return</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-check2-circle fs-1 d-block mb-2 text-success"></i>
                                No pending approval requests.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace small">TX-@item.LendingId.ToString("D4")</td>
                                <td>
                                    <div class="fw-bold text-indigo-900">@item.Property?.Name</div>
                                    <small class="text-muted font-monospace small">ID: @item.PropertyId</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark d-flex align-items-center flex-wrap gap-1">
                                        <span>@item.BorrowerName</span>
                                        @{
                                            int uid = item.BorrowedBy ?? -1;
                                            var flagged = ViewBag.FlaggedBorrowers as Dictionary<int, int>;
                                        }
                                        @if (flagged != null && uid > 0 && flagged.TryGetValue(uid, out int missedCount))
                                        {
                                            <span class="badge bg-danger text-white shadow-sm" title="Borrower has @missedCount overdue condition report check-in(s) on active tools!">
                                                <i class="bi bi-flag-fill me-1"></i>⚠️ Missed Check-ins (@missedCount)
                                            </span>
                                        }
                                    </div>
                                    <small class="text-muted font-monospace small">Student ID: @item.StudentId</small>
                                </td>
                                <td class="small">@item.DateBorrowed.ToString("yyyy-MM-dd")</td>
                                <td class="small fw-semibold">@item.DueDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning">Pending Approval</span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex gap-2">
                                        <form method="post" action="/Approval/Approve">
                                            <input type="hidden" name="id" value="@item.LendingId" />
                                            <button type="submit" class="btn btn-sm btn-success px-3 shadow-sm fw-semibold" onclick="return confirm('Approve borrowing request for @item.Property?.Name?');">
                                                <i class="bi bi-check-lg me-1"></i>Approve
                                            </button>
                                        </form>
                                        <form method="post" action="/Approval/Reject">
                                            <input type="hidden" name="id" value="@item.LendingId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3 shadow-sm fw-semibold" onclick="return confirm('Reject borrowing request for @item.Property?.Name?');">
                                                <i class="bi bi-x-lg me-1"></i>Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
