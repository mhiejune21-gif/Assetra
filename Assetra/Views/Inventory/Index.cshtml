@model List<Assetra.Models.Property>
@{
    ViewData["Title"] = "Tool Inventory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold text-dark">Tool & Equipment Inventory</h4>
        <p class="text-muted small mb-0">View, register, print QR codes, and manage school tools.</p>
    </div>
    <a href="/Inventory/Create" class="btn btn-indigo shadow-sm"><i class="bi bi-plus-circle me-1"></i> Add New Tool</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tool ID</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Qty</th>
                        <th>Storage Location</th>
                        <th>Status</th>
                        <th>Condition</th>
                        <th>Date Added</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                                No tools found in the inventory.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace fw-semibold text-indigo-900">@item.PropertyId</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 250px;">@item.Description</small>
                                </td>
                                <td class="small fw-semibold text-secondary">@item.Category</td>
                                <td class="fw-semibold">@item.Quantity</td>
                                <td class="small text-muted">@item.Location</td>
                                <td>
                                    @if (item.Status == "Available")
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success">Available</span>
                                    }
                                    else if (item.Status == "Borrowed" || item.Status == "On Loan")
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning">Borrowed</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(item.ConditionStatus == "Good" ? "bg-success" : item.ConditionStatus == "Minor Damage" ? "bg-info text-dark" : item.ConditionStatus == "Damaged" ? "bg-warning text-dark" : "bg-danger")">
                                        @item.ConditionStatus
                                    </span>
                                </td>
                                <td class="text-muted small">@item.DateAdded.ToString("yyyy-MM-dd")</td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group">
                                        <a href="/Inventory/Details/@item.PropertyId" class="btn btn-sm btn-outline-primary" title="Details"><i class="bi bi-eye"></i></a>
                                        <a href="/Inventory/PrintQR/@item.PropertyId" target="_blank" class="btn btn-sm btn-outline-indigo" title="Print QR"><i class="bi bi-printer"></i></a>
                                        <a href="/Inventory/Edit/@item.PropertyId" class="btn btn-sm btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a href="/Inventory/Delete/@item.PropertyId" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this tool?');"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .btn-indigo {
        background-color: #4f46e5;
        color: white;
    }
    .btn-indigo:hover {
        background-color: #4338ca;
        color: white;
    }
    .btn-outline-indigo {
        border-color: #6366f1;
        color: #6366f1;
    }
    .btn-outline-indigo:hover {
        background-color: #6366f1;
        color: #fff;
    }
</style>
