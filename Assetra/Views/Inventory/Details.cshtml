@model Assetra.Models.Property
@{
    ViewData["Title"] = "Asset Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var history = ViewBag.ConditionHistory as List<Assetra.Models.ConditionHistory> ?? new List<Assetra.Models.ConditionHistory>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-dark">Tool Details</h4>
    <a href="/Inventory" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Inventory</a>
</div>

<div class="row">
    <!-- Left Column: Details -->
    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                    <div class="me-3 bg-indigo-50 text-indigo-600 p-3 rounded">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                    <div>
                        <h4 class="mb-1 text-dark fw-bold">@Model.Name</h4>
                        <span class="text-muted font-monospace">Tool ID: @Model.PropertyId</span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Category:</div>
                    <div class="col-sm-8 text-dark fw-medium">@Model.Category</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Quantity:</div>
                    <div class="col-sm-8 text-dark">@Model.Quantity</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Storage Location:</div>
                    <div class="col-sm-8 text-dark">@Model.Location</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Current Status:</div>
                    <div class="col-sm-8">
                        <span class="badge rounded-pill @(Model.Status == "Available" ? "bg-success-subtle text-success border border-success" : Model.Status == "Borrowed" || Model.Status == "On Loan" ? "bg-warning-subtle text-warning border border-warning" : "bg-danger-subtle text-danger border border-danger")">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Condition Status:</div>
                    <div class="col-sm-8">
                        <span class="badge rounded-pill @(Model.ConditionStatus == "Good" ? "bg-success" : Model.ConditionStatus == "Minor Damage" ? "bg-info text-dark" : Model.ConditionStatus == "Damaged" ? "bg-warning text-dark" : "bg-danger")">
                            @Model.ConditionStatus
                        </span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Description:</div>
                    <div class="col-sm-8 text-dark">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</div>
                </div>

                <div class="row mb-4">
                    <div class="col-sm-4 text-muted fw-semibold">Date Registered:</div>
                    <div class="col-sm-8 text-dark">@Model.DateAdded.ToString("MMMM dd, yyyy 'at' hh:mm tt")</div>
                </div>

                <div class="border-top pt-3 d-flex gap-2">
                    <a href="/Inventory/Edit/@Model.PropertyId" class="btn btn-warning text-dark"><i class="bi bi-pencil me-1"></i> Edit Tool</a>
                    <a href="/Inventory/Delete/@Model.PropertyId" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this tool?');"><i class="bi bi-trash me-1"></i> Delete</a>
                </div>
            </div>
        </div>

        <!-- Condition History Log -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-indigo-600 me-2"></i>Condition Logs & History</h5>
                @if (!history.Any())
                {
                    <p class="text-muted small my-3">No condition logs recorded for this tool.</p>
                }
                else
                {
                    <div class="timeline mt-3">
                        @foreach (var h in history)
                        {
                            <div class="d-flex align-items-start mb-3 border-bottom pb-3">
                                <div class="font-monospace text-muted small me-4" style="min-width: 140px;">
                                    @h.DateRecorded.ToString("yyyy-MM-dd HH:mm")
                                </div>
                                <div class="flex-grow-1">
                                    <span class="badge rounded-pill me-2 @(h.ConditionStatus == "Good" ? "bg-success" : h.ConditionStatus == "Minor Damage" ? "bg-info text-dark" : h.ConditionStatus == "Damaged" ? "bg-warning text-dark" : "bg-danger")">
                                        @h.ConditionStatus
                                    </span>
                                    <span class="text-dark small">@h.Notes</span>
                                    <span class="text-muted small ms-1">(by @h.RecordedBy)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Borrower Monitoring Reports Timeline -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-shield-check text-indigo-600 me-2"></i>Borrower Condition Reports (Timeline)</h5>
                @{
                    var reports = ViewBag.ConditionReports as List<Assetra.Models.ConditionReport> ?? new List<Assetra.Models.ConditionReport>();
                }
                @if (!reports.Any())
                {
                    <p class="text-muted small my-3">No condition monitoring reports submitted by borrowers yet.</p>
                }
                else
                {
                    <div class="timeline mt-3">
                        @foreach (var r in reports)
                        {
                            <div class="d-flex align-items-start mb-3 border-bottom pb-3">
                                <div class="font-monospace text-muted small me-4" style="min-width: 140px;">
                                    @r.DateSubmitted?.ToString("yyyy-MM-dd HH:mm")
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center mb-1">
                                        @if (r.Condition == "Good")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success me-2">🟢 Good</span>
                                        }
                                        else if (r.Condition == "Minor Damage")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning me-2">🟡 Minor Damage</span>
                                        }
                                        else if (r.Condition == "Critical Damage")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger me-2">🔴 Critical Damage</span>
                                        }
                                        else if (r.Condition == "For Repair")
                                        {
                                            <span class="badge bg-dark-subtle text-dark border border-dark me-2">🔧 For Repair</span>
                                        }
                                        <span class="text-muted small">submitted by <strong>@r.Lending?.BorrowerName</strong></span>
                                        @if (r.IsScheduled)
                                        {
                                            <span class="badge bg-light text-secondary border ms-2 small">Report #@r.ReportNumber</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white ms-2 small"><i class="bi bi-lightning-fill"></i> Incident</span>
                                        }
                                    </div>
                                    <p class="text-dark small mb-1">Remarks: <em>@r.Remarks</em></p>
                                    @if (!string.IsNullOrEmpty(r.PhotoPath))
                                    {
                                        <div class="mt-2">
                                            <a href="@r.PhotoPath" target="_blank" class="small text-indigo-600 text-decoration-none"><i class="bi-image me-1"></i>View Uploaded Photo</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: QR Code -->
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center">
                <h5 class="card-title fw-bold text-dark mb-3">Tool QR Code</h5>
                
                <div class="p-4 bg-white border rounded shadow-sm mb-3">
                    @if (string.IsNullOrEmpty(Model.QrCodePath))
                    {
                        <div class="py-5 px-4 text-muted font-monospace">
                            <i class="bi bi-qr-code-scan fs-1 d-block mb-2 text-secondary"></i>
                            No QR Code
                        </div>
                    }
                    else
                    {
                        <img src="@Model.QrCodePath" class="img-fluid" style="max-height: 180px;" alt="QR Code for @Model.PropertyId" />
                    }
                </div>
                
                <h6 class="font-monospace text-muted mb-3">ID: @Model.PropertyId</h6>

                <div class="d-grid gap-2 w-100">
                    <a href="/Inventory/PrintQR/@Model.PropertyId" target="_blank" class="btn btn-outline-indigo"><i class="bi bi-printer me-2"></i>Print QR Code</a>
                </div>

                <p class="small text-muted mt-3 mb-0">
                    This QR code contains only the unique tool ID <strong>@Model.PropertyId</strong>. Scanning it automatically identifies the tool in the borrowing and returning workflows.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-indigo-50 { background-color: #e0e7ff; }
    .text-indigo-600 { color: #4f46e5; }
    .btn-outline-indigo {
        border-color: #6366f1;
        color: #6366f1;
    }
    .btn-outline-indigo:hover {
        background-color: #6366f1;
        color: #fff;
    }
</style>
