@model List<Assetra.Models.User>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-dark">User Management</h4>
    <div>
        <button type="button" class="btn btn-outline-indigo me-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#importCsvModal">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Import Students (CSV)
        </button>
        <a href="/Users/Create" class="btn btn-indigo shadow-sm"><i class="bi bi-person-plus me-1"></i> Add New User</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 text-success py-2 px-3 small" style="background-color: #f0fdf4;" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4 text-danger py-2 px-3 small" style="background-color: #fef2f2;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">User ID</th>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Role</th>
                        <th>Date Registered</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2"></i>
                                No users found in the system.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace fw-semibold">USR-@user.UserId.ToString("D4")</td>
                                <td class="fw-semibold text-dark">@user.Username</td>
                                <td>
                                    <div class="d-flex align-items-center flex-wrap gap-1">
                                        <span>@user.FullName</span>
                                        @if (ViewBag.FlaggedBorrowers != null && ((Dictionary<int, int>)ViewBag.FlaggedBorrowers).ContainsKey(user.UserId))
                                        {
                                            int count = ((Dictionary<int, int>)ViewBag.FlaggedBorrowers)[user.UserId];
                                            <span class="badge bg-danger text-white ms-1" title="@count overdue condition report check-in(s)!">
                                                <i class="bi bi-flag-fill me-1"></i>⚠️ Flagged: Missed Reports (@count)
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(user.Role == "Admin" ? "bg-primary-subtle text-primary border border-primary" : "bg-secondary-subtle text-secondary border border-secondary")">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group">
                                        <a href="/Users/Edit/@user.UserId" class="btn btn-sm btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a href="/Users/Delete/@user.UserId" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this user?');"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Import CSV Modal -->
<div class="modal fade" id="importCsvModal" tabindex="-1" aria-labelledby="importCsvModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-dark" id="importCsvModalLabel"><i class="bi bi-file-earmark-spreadsheet text-indigo-600 me-2"></i>Import Students from CSV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Users/ImportCsv" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <p class="small text-muted">Select a CSV file containing your student list. The system will parse the records and create their accounts automatically.</p>
                    
                    <div class="mb-3 p-3 bg-light border rounded small">
                        <strong class="text-dark d-block mb-1">CSV File Format:</strong>
                        <span class="d-block text-muted mb-1">The first row should contain column headers (optional <code>Role</code> and <code>Password</code>):</span>
                        <code class="d-block font-monospace bg-white border p-1.5 rounded mb-2">Username,FullName,Role,Password</code>
                        <span class="d-block text-muted mb-2">Example rows:</span>
                        <code class="d-block font-monospace bg-white border p-1.5 rounded">2026-0001,John Doe,User,studentpass123<br>admin_jane,Jane Smith,Admin,adminpass456</code>
                        <span class="d-block text-muted mt-2" style="font-size: 11px;"><i class="bi bi-info-circle me-1"></i> Role can be <code>Admin</code> or <code>User</code> (defaults to <code>User</code> if omitted).</span>
                        <span class="d-block text-success mt-1 fw-semibold" style="font-size: 11px;"><i class="bi bi-key-fill me-1"></i> Password: If provided, sets their initial password. If left empty, defaults to their Username.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Select CSV File</label>
                        <input type="file" name="csvFile" accept=".csv" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-indigo">Upload and Create Accounts</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .btn-indigo {
        background-color: #4f46e5;
        color: white;
    }
    .btn-indigo:hover {
        background-color: #4338ca;
        color: white;
    }
    .btn-outline-indigo {
        border-color: #6366f1;
        color: #6366f1;
    }
    .btn-outline-indigo:hover {
        background-color: #6366f1;
        color: white;
    }
    .text-indigo-600 {
        color: #4f46e5;
    }
</style>
